<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- .NET Framework 4.8 ships with Windows 10 (1903+) and 11, so users install nothing. -->
    <TargetFramework>net48</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>7.3</LangVersion>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <AssemblyName>TempMonitor</AssemblyName>
    <RootNamespace>TempMonitor</RootNamespace>

    <!-- LibreHardwareMonitorLib ships its DLL only under runtimes/<rid>/, so a RID is required. -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PlatformTarget>x64</PlatformTarget>
    <SelfContained>false</SelfContained>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>

    <!-- Overridden by CI from the git tag, e.g. v1.2.0 -> 1.2.0 -->
    <Version>1.0.0</Version>
    <Product>Temp Monitor</Product>
    <AssemblyTitle>Temp Monitor</AssemblyTitle>
    <Description>Live temperatures from all hardware sensors.</Description>
    <Copyright>MIT License</Copyright>
    <Deterministic>true</Deterministic>
    <DebugType>embedded</DebugType>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="LibreHardwareMonitorLib" Version="0.9.6" />
    <PackageReference Include="Costura.Fody" Version="6.0.0" PrivateAssets="all" />
  </ItemGroup>

</Project>
